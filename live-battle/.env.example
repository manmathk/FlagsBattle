# Server
PORT=8787
PUBLIC_URL=http://localhost:8787

# YouTube OAuth 2.0 Web Application credentials
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Optional: lock the app to one live broadcast ID.
YOUTUBE_BROADCAST_ID=

# Scoring
COMMENT_POINTS=1
PAID_POINTS=1000

# One accepted comment vote per viewer per cooldown window.
VOTE_COOLDOWN_MS=12000

# Quota protection. The server still honors YouTube's pollingIntervalMillis,
# but never polls more frequently than this floor.
YOUTUBE_MIN_POLL_MS=10000
YOUTUBE_DISCOVERY_MS=60000

# Keep true for local demo controls; use false in production.
DEMO_MODE=true
